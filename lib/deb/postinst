#!/bin/bash
# Debian maintainer script, run after the package's files are unpacked.
#
# Everything it does lives in obd-setup.sh, which is the same implementation
# scripts/install-overlaybd.sh calls, so a host wired by the package and a host
# wired by the script end up identical.
#
# --daemon systemd because a maintainer script must not spawn a daemon of its
# own: a package has to install cleanly in a chroot, in an image build, and on
# a kernel without TCMU. Where systemd is running the daemon is started
# properly; where it is not, `obdctl preflight` reports what is left to do.
set -e

case "$1" in
configure)
  /usr/share/obd-rs/shell/obd-setup.sh --daemon systemd
  ;;
esac
